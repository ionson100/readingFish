<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:readingFish.ViewModels"
             xmlns:models="using:readingFish.Models"
             xmlns:views="using:readingFish.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="readingFish.Views.ProjectView"
             x:DataType="vm:ProjectViewModel">

    <!-- Список частей и редактор делят свободную высоту по EditorRatio.
         Высоты строк задаются из кода: у RowDefinition нет DataContext,
         поэтому {Binding} в Height молча не срабатывает. -->
    <Grid x:Name="RootGrid" Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition MinHeight="90" />
            <RowDefinition Height="6" />
            <RowDefinition MinHeight="140" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <Button Grid.Column="0" Content="← К проектам" VerticalAlignment="Center"
                    Command="{Binding BackCommand}"
                    ToolTip.Tip="Вернуться к списку проектов" />

            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                <TextBlock FontSize="12" Foreground="#801B1B1B">
                    <Run Text="Голос:" /><Run Text="{Binding VoiceDisplay}" />
                    <Run Text=" · Файл:" /><Run Text="{Binding SourceFileName}" />
                </TextBlock>
            </StackPanel>

            <Button Grid.Column="2" Content="Папка audio" VerticalAlignment="Center"
                    Command="{Binding OpenFolderCommand}" />
        </Grid>

        <!-- Прогресс -->
        <Border Grid.Row="1" Background="#10F4F4F4" CornerRadius="6" Padding="14" Margin="0,0,0,10">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" FontSize="13" />
                        <TextBlock FontSize="12" Foreground="#801B1B1B">
                            <Run Text="Готово частей: " /><Run Text="{Binding ProgressLabel}" />
                            <Run Text="  (" /><Run Text="{Binding ProgressText}" /><Run Text=")" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Синтезировать"
                                Command="{Binding SynthesizeCommand}"
                                IsEnabled="{Binding !IsBusy}" />
                        <Button Content="Остановить"
                                Command="{Binding StopCommand}"
                                IsVisible="{Binding IsBusy}" />
                        <Button Content="Перегенерировать всё"
                                Command="{Binding RegenerateAllCommand}"
                                IsEnabled="{Binding !IsBusy}" />
                    </StackPanel>
                </Grid>

                <ProgressBar Value="{Binding Progress}" Maximum="100" Height="8"
                             Minimum="0" />

                <!-- Параметры синтеза: свои у каждого проекта -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,10,0,0">
                    <Button Grid.Column="0" Content="Параметры синтеза" Classes="accent"
                            Command="{Binding EditSynthesisOptionsCommand}"
                            IsEnabled="{Binding !IsBusy}" />

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SynthesisSummary}" FontSize="12"
                                   Foreground="#801B1B1B" TextWrapping="Wrap" />
                        <TextBlock Text="значения по умолчанию" FontSize="11" Foreground="#806A00"
                                   IsVisible="{Binding !HasCustomSynthesis}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Список частей -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <TextBlock Grid.Row="0" Text="Части текста" FontSize="15"
                       FontWeight="SemiBold" Margin="0,0,0,6" />

            <ListBox Grid.Row="1" ItemsSource="{Binding Parts}"
                     SelectedItem="{Binding SelectedPart}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:ProjectPart">
                        <Border Padding="10" Margin="0,0,0,4" Background="#0AF4F4F4" CornerRadius="4">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2">
                                <TextBlock Grid.Column="0" Width="42" VerticalAlignment="Center"
                                           FontSize="12" Foreground="#801B1B1B"
                                           Text="{Binding Index, StringFormat='№ {0}'}" />

                                <TextBlock Grid.Column="1" Text="{Binding Text}"
                                           TextWrapping="Wrap" MaxLines="3"
                                           Margin="8,0" VerticalAlignment="Center" />

                                <Border Grid.Column="2" Padding="8,2" CornerRadius="10"
                                        VerticalAlignment="Center" Background="#142A5C00">
                                    <TextBlock Text="{Binding StatusText}" FontSize="11" />
                                </Border>

                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                            Spacing="4" Margin="8,0" VerticalAlignment="Center">
                                    <Button Content="▶" Padding="8,2"
                                            IsVisible="{Binding !IsPlaying}"
                                            IsEnabled="{Binding $parent[ListBox].((vm:ProjectViewModel)DataContext).CanEditParts}"
                                            Command="{Binding $parent[ListBox].((vm:ProjectViewModel)DataContext).PlayPartCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="■" Padding="8,2"
                                            IsVisible="{Binding IsPlaying}"
                                            Command="{Binding $parent[ListBox].((vm:ProjectViewModel)DataContext).StopPartCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Content="Изменить" Padding="8,2"
                                            IsEnabled="{Binding $parent[ListBox].((vm:ProjectViewModel)DataContext).CanEditParts}"
                                            Command="{Binding $parent[ListBox].((vm:ProjectViewModel)DataContext).EditPartCommand}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Разделитель. Обе строки — звёзды, поэтому GridSplitter не годится:
             он двигает только пиксели. Тянем границу вручную, пересчитывая долю. -->
        <Border x:Name="EditorSplitter" Grid.Row="3" Height="6" Background="Transparent"
                Cursor="SizeNorthSouth"
                PointerPressed="OnEditorSplitterPressed"
                PointerMoved="OnEditorSplitterMoved"
                PointerReleased="OnEditorSplitterReleased"
                PointerCaptureLost="OnEditorSplitterCaptureLost">
            <Border Height="1" VerticalAlignment="Center" Background="#1F000000" />
        </Border>

        <!-- Редактор исходного текста внизу. Звезда по EditorRatio:
             поле занимает всю доступную высоту и тянется вместе с окном. -->
        <Border Grid.Row="4" Background="#10F4F4F4" CornerRadius="6"
                Padding="12" Margin="0,4,0,0" MinHeight="120">
            <Grid RowDefinitions="Auto,*,Auto">

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10"
                            Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Исходный текст" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="source.txt" FontSize="11" Foreground="#801B1B1B"
                               VerticalAlignment="Center" />
                    <TextBlock Text="· есть несохранённые правки" FontSize="11"
                               Foreground="#B3261E" VerticalAlignment="Center"
                               IsVisible="{Binding HasUnsavedText}" />
                </StackPanel>

                <!-- Поле ввода: без фиксированной высоты, заполняет всю область -->
                <TextBox x:Name="SourceTextBox" Grid.Row="1"
                         Text="{Binding SourceText, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         FontSize="{Binding EditorFontSize}"
                         FontWeight="{Binding EditorFontBold, Converter={x:Static views:Converters.BoldToFontWeight}}"
                         IsReadOnly="{Binding IsBusy}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />

                <!-- Панель управления. Столбцы Auto, чтобы блоки не сжимались,
                     иначе на узком окне подписи и числа обрезаются. -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="Размер части" FontSize="12" Foreground="#801B1B1B"
                                   VerticalAlignment="Center" />
                        <NumericUpDown x:Name="PartSizeBox" Minimum="20" Maximum="5000" Increment="10"
                                       FormatString="0" Value="{Binding EditorTargetChars}"
                                       MinWidth="96" Width="96" />
                        <TextBlock FontSize="12" Foreground="#801B1B1B" VerticalAlignment="Center">
                            <Run Text="частей:" /><Run Text="{Binding EstimatedParts}" />
                        </TextBlock>

                        <Border Width="1" Margin="4,0" Background="#1F000000" />

                        <TextBlock Text="Шрифт" FontSize="12" Foreground="#801B1B1B"
                                   VerticalAlignment="Center" />
                        <NumericUpDown x:Name="FontSizeBox" Minimum="9" Maximum="32" Increment="1"
                                       FormatString="0" Value="{Binding EditorFontSize}"
                                       MinWidth="80" Width="80" />
                        <ToggleButton x:Name="BoldToggle" Content="Ж"
                                      IsChecked="{Binding EditorFontBold, Mode=TwoWay}"
                                      MinWidth="34" Padding="8,3" VerticalAlignment="Center"
                                      ToolTip.Tip="Жирный шрифт" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ReloadButton" Content="Перечитать файл" Command="{Binding ReloadSourceCommand}" />
                        <Button Content="Сохранить и разбить" Command="{Binding SaveSourceCommand}"
                                IsEnabled="{Binding !IsBusy}" Classes="accent" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Результат -->
        <Border Grid.Row="5" Background="#10F4F4F4" CornerRadius="6" Padding="14" Margin="0,10,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Результирующий файл" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ResultInfo}" FontSize="12" Foreground="#801B1B1B" />
                    <TextBlock Text="Файл устарел — перегенерируйте проект"
                               FontSize="12" Foreground="#B3261E"
                               IsVisible="{Binding IsResultStale}" />
                    <TextBlock Text="{Binding PlaybackStatus}" FontSize="12" Foreground="#1B5E20"
                               IsVisible="{Binding HasPlaybackStatus}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <Button Content="Слушать" Command="{Binding PlayResultCommand}"
                            IsVisible="{Binding ShowPlayResult}" />
                    <Button Content="Остановить" Command="{Binding StopPlaybackCommand}"
                            IsVisible="{Binding CanStopPlayback}" />
                    <Button Content="Пересобрать" Command="{Binding RebuildResultCommand}"
                            IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
