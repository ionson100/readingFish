<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:readingFish.ViewModels"
        xmlns:views="using:readingFish.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="640"
        x:Class="readingFish.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="readingFish"
        Width="1000" Height="640"
        MinWidth="820" MinHeight="520">

    <Window.DataTemplates>
        <DataTemplate DataType="vm:ProjectsViewModel">
            <views:ProjectsView />
        </DataTemplate>
        <DataTemplate DataType="vm:VoicesViewModel">
            <views:VoicesView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProjectViewModel">
            <views:ProjectView />
        </DataTemplate>
    </Window.DataTemplates>

    <DockPanel>
        <!-- Боковое меню -->
        <Border DockPanel.Dock="Left" Width="180" Background="#20F4F4F4">
            <StackPanel Margin="0,16,0,0" Spacing="4">
                <TextBlock Text="readingFish"
                           Margin="16,0,0,14"
                           FontSize="18" FontWeight="SemiBold" />

                <Button Content="Проекты"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="8,0" Padding="12,10"
                        Command="{Binding ShowProjectsCommand}" />

                <Button Content="Голоса"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="8,0" Padding="12,10"
                        Command="{Binding ShowVoicesCommand}" />

                <Button Content="Настройки"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Margin="8,0" Padding="12,10"
                        Command="{Binding ShowSettingsCommand}" />

                <Border Height="1" Margin="12,14" Background="#1A000000" />

                <TextBlock Text="Данные приложения"
                           Margin="16,0,0,4" FontSize="11" Foreground="#801B1B1B" />
                <TextBlock Text="~/fishApp"
                           Margin="16,0" FontSize="12" Foreground="#801B1B1B" />
            </StackPanel>
        </Border>

        <!-- Содержимое -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#12F4F4F4" Padding="20,14">
                <TextBlock Text="{Binding CurrentPageTitle}" FontSize="20" FontWeight="SemiBold" />
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />
        </Grid>
    </DockPanel>
</Window>
