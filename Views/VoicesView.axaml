<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:readingFish.ViewModels"
             xmlns:models="using:readingFish.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="500"
             x:Class="readingFish.Views.VoicesView"
             x:DataType="vm:VoicesViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
            <Button Content="Добавить голос" Command="{Binding AddVoiceCommand}" />
            <Button Content="Обновить" Command="{Binding RefreshCommand}" />
            <ProgressBar IsIndeterminate="True" Width="90" Height="4"
                         VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <TextBlock Text="Голосов пока нет. Нажмите «Добавить голос», чтобы выбрать запись."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="15" Foreground="#801B1B1B"
                       IsVisible="{Binding !Voices.Count}" />

            <ListBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}"
                     IsVisible="{Binding Voices.Count}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:VoiceSample">
                        <Border Padding="12" Margin="0,0,0,6" Background="#10F4F4F4" CornerRadius="6">
                            <Grid ColumnDefinitions="*,Auto" >
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" />

                                        <!-- Пометки о том, где лежит голос -->
                                        <Border Padding="6,1" CornerRadius="8" Background="#142A5C00"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsOnServer}">
                                            <TextBlock Text="на сервере" FontSize="10" />
                                        </Border>
                                        <Border Padding="6,1" CornerRadius="8" Background="#1A806A00"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsServerOnly}">
                                            <TextBlock Text="нет записи локально" FontSize="10" />
                                        </Border>
                                        <Border Padding="6,1" CornerRadius="8" Background="#1AB3261E"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsLocalOnly}">
                                            <TextBlock Text="не отправлен" FontSize="10" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding TextOrPlaceholder}" FontSize="12"
                                               Foreground="#801B1B1B" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                                               Foreground="#601B1B1B" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Удалить" VerticalAlignment="Center"
                                        Command="{Binding $parent[ListBox].((vm:VoicesViewModel)DataContext).DeleteVoiceCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0" Spacing="4">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#801B1B1B"
                       TextWrapping="Wrap" />
            <TextBlock FontSize="12" Foreground="#801B1B1B"
                       Text="Запись: 5–15 секунд чистой речи. Текст должен точно совпадать с произнесённым." />
        </StackPanel>
    </Grid>
</UserControl>
