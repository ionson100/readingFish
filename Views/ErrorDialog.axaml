<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:readingFish.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="400"
        x:Class="readingFish.Views.ErrorDialog"
        x:DataType="vm:MessageViewModel"
        Title="{Binding Title}"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="{Binding Header}" FontSize="16" FontWeight="SemiBold" />

        <Border Background="#0AF4F4F4" CornerRadius="4" Padding="10" MaxHeight="320">
            <ScrollViewer>
                <TextBox Text="{Binding Message}"
                         IsReadOnly="True"
                         Background="Transparent" BorderThickness="0"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         FontFamily="monospace"
                         FontSize="12" />
            </ScrollViewer>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Скопировать текст" Command="{Binding CopyCommand}" />
            <TextBlock Text="Скопировано" VerticalAlignment="Center" FontSize="12"
                       Foreground="#2A5C00" IsVisible="{Binding IsCopied}" />
            <Button Content="Закрыть" Command="{Binding CloseCommand}" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
